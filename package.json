{
  "name": "setula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js",
    "build": "npm run build:web && npm run typecheck",
    "dev": "npm run build:web && tsx --env-file-if-exists=.env src/server.ts",
    "start": "npm run build:web && tsx --env-file-if-exists=.env src/server.ts",
    "verify:golden-path": "tsx --env-file=.env scripts/run-golden-path.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.25.9",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
