# Circle developer-controlled wallet credentials. Never commit populated values.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Proven Arc Testnet wallets from setula-arc-spike.
CIRCLE_WALLET_A_ID=
CIRCLE_WALLET_A_ADDRESS=
CIRCLE_WALLET_B_ID=
CIRCLE_WALLET_B_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_USDC_TOKEN_ID=

# Required on the simulated payout callback.
PAYOUT_CALLBACK_SECRET=replace-with-a-local-secret

# Optional runtime controls.
PORT=4000
DATA_FILE=.setula-data.json
POLL_INTERVAL_MS=2000
POLL_TIMEOUT_MS=180000
